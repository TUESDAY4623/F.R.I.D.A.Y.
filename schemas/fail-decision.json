{
  "$defs": {
    "ErrorRecord": {
      "additionalProperties": false,
      "description": "A single recorded error. Stored in AgentState.errors (append-only).",
      "properties": {
        "code": {
          "description": "Error code.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Human-readable description of the error.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether retry/recovery is possible.",
          "title": "Recoverable",
          "type": "boolean"
        },
        "context": {
          "additionalProperties": true,
          "description": "Additional error context.",
          "title": "Context",
          "type": "object"
        },
        "timestamp": {
          "description": "When the error occurred.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "FailParams": {
      "additionalProperties": false,
      "description": "Parameters for a FAIL decision.",
      "properties": {
        "reason": {
          "description": "Why the task failed.",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ErrorRecord describing the failure."
        }
      },
      "required": [
        "reason"
      ],
      "title": "FailParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Decision: signal that the task cannot be completed.",
  "properties": {
    "id": {
      "description": "Unique decision identifier.",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "reasoning": {
      "description": "LLM's reasoning for this decision.",
      "minLength": 1,
      "title": "Reasoning",
      "type": "string"
    },
    "confidence": {
      "description": "Decision confidence (0.0–1.0).",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "target_node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Denormalized convenience copy per ADR 04; the corresponding decision parameter model's `target_node_id` is authoritative and must not be overridden by this field. No schema-level cross-field consistency rule is enforced.",
      "title": "Target Node Id"
    },
    "retry_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Decision Engine's reasoning about the current retry attempt (1-indexed). AgentState.retry_count is authoritative — the Orchestrator must not trust this field over AgentState.retry_count.",
      "title": "Retry Count"
    },
    "timestamp": {
      "description": "When this decision was produced.",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "type": {
      "const": "FAIL",
      "default": "FAIL",
      "title": "Type",
      "type": "string"
    },
    "parameters": {
      "$ref": "#/$defs/FailParams"
    }
  },
  "required": [
    "id",
    "reasoning",
    "confidence",
    "parameters"
  ],
  "title": "FailDecision",
  "type": "object"
}