        "confidence",
        "parameters"
      ],
      "title": "FailDecision",
      "type": "object"
    },
    "FailParams": {
      "additionalProperties": false,
      "description": "Parameters for a FAIL decision.",
      "properties": {
        "reason": {
          "description": "Why the task failed.",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ErrorRecord describing the failure."
        }
      },
      "required": [
        "reason"
      ],
      "title": "FailParams",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "description": "Validated, canonical intent produced by the Intent Manager.\n\nThe Intent Manager takes Laya's raw classification and produces a\nvalidated, canonical intent representation. The Intent does NOT\nindependently classify the request — it normalizes and enriches\nLaya's classification.",
      "properties": {
        "request_id": {
          "description": "Links back to the originating Request.",
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "laya_category": {
          "$ref": "#/$defs/LayaCategory",
          "description": "Laya's raw category (preserved from LayaClassification)."
        },
        "normalized_form": {
          "description": "Canonical representation of the intent.",
          "minLength": 1,
          "title": "Normalized Form",
          "type": "string"
        },
        "entities": {
          "description": "Validated and enriched entities (from LayaClassification).",
          "items": {
            "$ref": "#/$defs/ExtractedEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "constraints": {
          "description": "Identified constraints (refined from LayaClassification.characteristics).",
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "confidence": {
          "description": "Intent Manager's confidence in the normalized form (0.0–1.0).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "ambiguous": {
          "description": "Whether the intent remains ambiguous after normalization.",
          "title": "Ambiguous",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Additional context from Intent Manager.",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "laya_category",
        "normalized_form",
        "confidence",
        "ambiguous"
      ],
      "title": "Intent",
      "type": "object"
    },
    "LayaCategory": {
      "description": "Semantic intent categories identified by Laya.",
      "enum": [
        "informational",
        "actionable",
        "query",
        "command"
      ],
      "title": "LayaCategory",
      "type": "string"
    },
    "LayaClassification": {
      "additionalProperties": false,
      "description": "Raw semantic classification produced by Laya.\n\nLaya classifies the user's request semantically: intent category,\nentity extraction, confidence, and ambiguity detection.\nTask complexity is NOT assessed here — that belongs to TaskProfile.",
      "properties": {
        "request_id": {
          "description": "Links back to the originating Request.",
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/LayaCategory",
          "description": "Semantic intent category (e.g., informational, actionable, query, command)."
        },
        "entities": {
          "description": "Entities extracted from the request.",
          "items": {
            "$ref": "#/$defs/ExtractedEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "characteristics": {
          "description": "Identified request characteristics (e.g., multi-step, external-data).",
          "items": {
            "$ref": "#/$defs/RequestCharacteristic"
          },
          "title": "Characteristics",
          "type": "array"
        },
        "confidence": {
          "description": "Classification confidence score (0.0–1.0).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "ambiguous": {
          "description": "Whether the request is ambiguous.",
          "title": "Ambiguous",
          "type": "boolean"
        },
        "ambiguity_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the request is ambiguous. Null if not ambiguous.",
          "title": "Ambiguity Reason"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Additional classification details.",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "category",
        "confidence",
        "ambiguous"
      ],
      "title": "LayaClassification",
      "type": "object"
    },
    "NodeStatus": {
      "description": "Lifecycle status of a TaskGraph node.",
      "enum": [
        "pending",
        "active",
        "completed",
        "failed",
        "skipped",
        "retrying"
      ],
      "title": "NodeStatus",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "A result returned after executing an action or gathering information.",
      "properties": {
        "source": {
          "description": "What produced this observation (tool, user, system).",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "description": "The observed data.",
          "title": "Data",
          "type": "object"
        },
        "success": {
          "description": "Whether the action succeeded.",
          "title": "Success",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Error details if the observation was not successful."
        },
        "timestamp": {
          "description": "When the observation was recorded.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "source",
        "success"
      ],
      "title": "Observation",
      "type": "object"
    },
