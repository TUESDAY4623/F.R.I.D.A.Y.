  "additionalProperties": false,
  "description": "Runtime state of a single task execution.\n\nAgentState is transient — it exists only for the duration of a single task\nexecution and is never persisted. It is distinct from persistent memory.\n\nThis contract carries no runtime behavior: it does not execute tools,\nmake decisions, or enforce limits. The Agent Orchestrator owns all\nmutation and all limit enforcement.",
  "properties": {
    "request": {
      "$ref": "#/$defs/Request",
      "description": "The original request."
    },
    "intent": {
      "$ref": "#/$defs/Intent",
      "description": "The classified intent."
    },
    "laya_classification": {
      "$ref": "#/$defs/LayaClassification",
      "description": "Laya's classification."
    },
    "task_profile": {
      "$ref": "#/$defs/TaskProfile",
      "description": "Profiled task characteristics."
    },
    "task_graph": {
      "$ref": "#/$defs/TaskGraph",
      "description": "Current (possibly revised) task graph."
    },
    "execution_history": {
      "description": "Record of all steps taken. Append-only (ADR 05).",
      "items": {
        "$ref": "#/$defs/ExecutionStep"
      },
      "title": "Execution History",
      "type": "array"
    },
    "current_step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ID of the currently active node.",
      "title": "Current Step Id"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus",
      "default": "PENDING",
      "description": "Overall task status."
    },
    "observations": {
      "description": "Collected observations.",
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "errors": {
      "description": "Error history. Append-only (ADR 05, ADR 11).",
      "items": {
        "$ref": "#/$defs/ErrorRecord"
      },
      "title": "Errors",
      "type": "array"
    },
    "retry_count": {
      "default": 0,
      "description": "Authoritative runtime retry counter for the current node. Incremented by the Agent Orchestrator only.",
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "replan_count": {
      "default": 0,
      "description": "Number of REPLAN decisions issued for this task.",
      "minimum": 0,
      "title": "Replan Count",
      "type": "integer"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Additional runtime data.",
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "request",
    "intent",
    "laya_classification",
    "task_profile",
    "task_graph"
  ],
  "title": "AgentState",
  "type": "object"
