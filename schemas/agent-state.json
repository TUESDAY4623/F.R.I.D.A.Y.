    "TaskGraphEdge": {
      "additionalProperties": false,
      "description": "A dependency relationship between two graph nodes.\n\nThe `from_` field references the source node ID. The `to` field\nreferences the target node ID. Edge type describes the relationship.\n\nThe Python attribute is `from_` because `from` is a reserved keyword.\nThe documented external contract name is `from`, which is enforced\nvia the alias. `populate_by_name=True` keeps `from_` accepted on\ninput for Python-side construction; `serialize_by_alias=True` makes\n`model_dump()` / `model_dump_json()` emit the documented `from` name\nby default so the output conforms to the generated JSON schema.",
      "properties": {
        "from": {
          "description": "Source node ID.",
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
        "to": {
          "description": "Target node ID.",
          "minLength": 1,
          "title": "To",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EdgeType",
          "description": "Type of dependency: sequence, condition, or alternative."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "title": "TaskGraphEdge",
      "type": "object"
    },
