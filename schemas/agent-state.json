        "timestamp": {
          "description": "When this decision was produced.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "COMPLETE",
          "default": "COMPLETE",
          "title": "Type",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/CompleteParams"
        }
      },
      "required": [
        "id",
        "reasoning",
        "confidence",
        "parameters"
      ],
      "title": "CompleteDecision",
      "type": "object"
    },
    "CompleteParams": {
      "additionalProperties": false,
      "description": "Parameters for a COMPLETE decision.",
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the completed task.",
          "title": "Summary"
        },
        "result": {
          "additionalProperties": true,
          "description": "Final result data.",
          "title": "Result",
          "type": "object"
        }
      },
      "title": "CompleteParams",
      "type": "object"
    },
    "Complexity": {
      "description": "Task Profiler's assessment of task complexity.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "EdgeType": {
      "description": "Type of dependency relationship between graph nodes.",
      "enum": [
        "sequence",
        "condition",
        "alternative"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "EntityType": {
      "description": "Types of entities that can be extracted from user requests.",
      "enum": [
        "file_path",
        "app_name",
        "url",
        "person",
        "email",
        "date",
        "time",
        "location",
        "number",
        "organization",
        "product",
        "command"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "ErrorRecord": {
      "additionalProperties": false,
      "description": "A single recorded error. Stored in AgentState.errors (append-only).",
      "properties": {
        "code": {
          "description": "Error code.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Human-readable description of the error.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether retry/recovery is possible.",
          "title": "Recoverable",
          "type": "boolean"
        },
        "context": {
          "additionalProperties": true,
          "description": "Additional error context.",
          "title": "Context",
          "type": "object"
        },
        "timestamp": {
          "description": "When the error occurred.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "ExecuteDecision": {
      "additionalProperties": false,
      "description": "Decision: execute the next planned action in the Task Graph.",
      "properties": {
        "id": {
          "description": "Unique decision identifier.",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reasoning": {
          "description": "LLM's reasoning for this decision.",
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        },
        "confidence": {
          "description": "Decision confidence (0.0–1.0).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "target_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Denormalized convenience copy per ADR 04; the corresponding decision parameter model's `target_node_id` is authoritative and must not be overridden by this field. No schema-level cross-field consistency rule is enforced.",
          "title": "Target Node Id"
        },
        "retry_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Decision Engine's reasoning about the current retry attempt (1-indexed). AgentState.retry_count is authoritative — the Orchestrator must not trust this field over AgentState.retry_count.",
          "title": "Retry Count"
        },
        "timestamp": {
          "description": "When this decision was produced.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "EXECUTE",
          "default": "EXECUTE",
          "title": "Type",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ExecuteParams"
        }
      },
      "required": [
        "id",
        "reasoning",
        "confidence",
        "parameters"
      ],
      "title": "ExecuteDecision",
      "type": "object"
    },
    "ExecuteParams": {
      "additionalProperties": false,
      "description": "Parameters for an EXECUTE decision.",
      "properties": {
        "target_node_id": {
          "description": "The Task Graph node to execute.",
          "minLength": 1,
          "title": "Target Node Id",
          "type": "string"
        },
        "tool_params": {
          "additionalProperties": true,
          "description": "Parameters to pass to the tool.",
          "title": "Tool Params",
          "type": "object"
        }
      },
      "required": [
        "target_node_id"
      ],
      "title": "ExecuteParams",
      "type": "object"
    },
    "ExecutionStep": {
      "additionalProperties": false,
      "description": "A single recorded step of the execution history (append-only).\n\nNote: `decision` is typed as the Decision union to satisfy the ADR 04\ncontract. It is declared after the Decision models are defined below.",
      "properties": {
        "step_number": {
          "description": "Sequential step number (1-indexed).",
          "minimum": 1,
          "title": "Step Number",
          "type": "integer"
        },
        "node_id": {
          "description": "Task Graph node that was executed.",
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecuteDecision"
            },
            {
              "$ref": "#/$defs/ObserveDecision"
            },
            {
              "$ref": "#/$defs/ReplanDecision"
            },
            {
              "$ref": "#/$defs/RetryDecision"
            },
            {
              "$ref": "#/$defs/AskUserDecision"
            },
            {
              "$ref": "#/$defs/WaitDecision"
            },
            {
              "$ref": "#/$defs/CompleteDecision"
            },
            {
              "$ref": "#/$defs/FailDecision"
            }
          ],
          "description": "The Decision that triggered this step.",
          "title": "Decision"
        },
        "action": {
          "description": "What was done.",
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation",
          "description": "Result of the action."
        },
        "verification": {
          "$ref": "#/$defs/VerificationResult",
          "description": "Outcome of verification."
        },
        "timestamp": {
          "description": "When this step occurred.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "duration_ms": {
          "description": "How long the step took, in milliseconds.",
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "step_number",
        "node_id",
        "decision",
        "action",
        "observation",
        "verification",
        "duration_ms"
      ],
      "title": "ExecutionStep",
      "type": "object"
    },
    "ExtractedEntity": {
      "additionalProperties": false,
      "description": "An entity extracted from the user's request by Laya.",
      "properties": {
        "type": {
          "$ref": "#/$defs/EntityType",
          "description": "The type of entity (e.g., file_path, app_name, url)."
        },
        "value": {
          "description": "The extracted entity value.",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "confidence": {
          "description": "Confidence score for this extraction (0.0–1.0).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "context": {
          "description": "Surrounding context from the request where the entity was found.",
          "minLength": 1,
          "title": "Context",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value",
        "confidence",
        "context"
      ],
      "title": "ExtractedEntity",
      "type": "object"
    },
