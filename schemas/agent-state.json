          "default": null,
          "description": "Decision Engine's reasoning about the current retry attempt (1-indexed). AgentState.retry_count is authoritative — the Orchestrator must not trust this field over AgentState.retry_count.",
          "title": "Retry Count"
        },
        "timestamp": {
          "description": "When this decision was produced.",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "OBSERVE",
          "default": "OBSERVE",
          "title": "Type",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ObserveParams"
        }
      },
      "required": [
        "id",
        "reasoning",
        "confidence",
        "parameters"
      ],
      "title": "ObserveDecision",
      "type": "object"
    },
    "ObserveParams": {
      "additionalProperties": false,
      "description": "Parameters for an OBSERVE decision.",
      "properties": {
        "observation_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What to observe.",
          "title": "Observation Target"
        },
        "observation_params": {
          "additionalProperties": true,
          "description": "Parameters for the observation.",
          "title": "Observation Params",
          "type": "object"
        }
      },
      "title": "ObserveParams",
      "type": "object"
    },
    "ReplanDecision": {
      "additionalProperties": false,
      "description": "Decision: revise the Task Graph in response to changed circumstances.",
